# ── Vi Assistant — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Required: Your Hugging Face token (read access is sufficient)
# Get one at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model to use (change to switch models instantly)
# Recommended free-tier options:
#   mistralai/Mistral-7B-Instruct-v0.3   ← default, best quality
#   HuggingFaceH4/zephyr-7b-beta         ← fast, good at chat
#   microsoft/Phi-3-mini-4k-instruct     ← smallest, fastest
#   google/gemma-2-2b-it                 ← ultra-fast 2B model
MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3

# Max tokens to generate (lower = faster on free tier)
MAX_NEW_TOKENS=512

# Optional: Custom system prompt
# SYSTEM_PROMPT=You are Vi, a concise and helpful personal AI assistant.
